{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camera-detector.local/schemas/0.1/camera_config.schema.json",
  "$defs": {
    "DetectorConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "zone_ids": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Ids"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "title": "DetectorConfig",
      "type": "object"
    },
    "SceneInfo": {
      "additionalProperties": false,
      "description": "Что известно о сцене; движок дополняет это измерениями на лету.",
      "properties": {
        "frame_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Width"
        },
        "frame_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Height"
        },
        "typical_person_height_frac": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typical Person Height Frac"
        },
        "camera_view": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Camera View"
        }
      },
      "title": "SceneInfo",
      "type": "object"
    },
    "StreamSource": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "transport": {
          "default": "tcp",
          "enum": [
            "tcp",
            "udp"
          ],
          "title": "Transport",
          "type": "string"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        },
        "password": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password"
        }
      },
      "required": [
        "url"
      ],
      "title": "StreamSource",
      "type": "object"
    },
    "Zone": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ZoneKind"
        },
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 64,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "id",
        "kind",
        "polygon"
      ],
      "title": "Zone",
      "type": "object"
    },
    "ZoneKind": {
      "enum": [
        "cash_drawer",
        "display",
        "include",
        "exclude"
      ],
      "title": "ZoneKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Конфигурация камеры: {camera_id, detectors: {id: {params...}}} плюс входы.",
  "properties": {
    "camera_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "title": "Camera Id",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/StreamSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fps": {
      "default": 5.0,
      "exclusiveMinimum": 0.0,
      "maximum": 30.0,
      "title": "Fps",
      "type": "number"
    },
    "scene": {
      "$ref": "#/$defs/SceneInfo"
    },
    "zones": {
      "items": {
        "$ref": "#/$defs/Zone"
      },
      "title": "Zones",
      "type": "array"
    },
    "external_sources": {
      "additionalProperties": {
        "items": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
          "type": "string"
        },
        "type": "array"
      },
      "title": "External Sources",
      "type": "object"
    },
    "detectors": {
      "patternProperties": {
        "^[a-z][a-z0-9_]{1,63}$": {
          "$ref": "#/$defs/DetectorConfig"
        }
      },
      "title": "Detectors",
      "type": "object"
    },
    "labels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Labels",
      "type": "object"
    }
  },
  "required": [
    "camera_id"
  ],
  "title": "CameraConfig",
  "type": "object"
}
